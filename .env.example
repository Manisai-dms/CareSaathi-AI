# CareSaathi AI - Environment Configuration

APP_NAME="CareSaathi AI"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEMO_MODE=true

# Database Configuration
DATABASE_PATH="caresaathi.db"

# Geospatial API Adapters (OpenStreetMap / Overpass)
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"
